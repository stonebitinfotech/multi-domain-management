# Run "npm run setup" to create .env automatically.

# Cloudflare API token (My Profile -> API Tokens). Never share this.
CF_API_TOKEN=

# Optional: Cloudflare account ID. If empty, the first account the token can see is used.
CF_ACCOUNT_ID=

# Panel login
ADMIN_USER=admin
# Created by "npm run setup" (scrypt:salt:hash). Do not put a plain password here.
ADMIN_PASSWORD_HASH=

# Random long string used to sign login cookies
SESSION_SECRET=

PORT=3000
# Set both to true when the panel runs behind HTTPS (nginx / Cloudflare / hosting proxy)
COOKIE_SECURE=false
TRUST_PROXY=false
